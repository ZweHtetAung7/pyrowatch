# NASA FIRMS: free key, emailed in minutes: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Google AI Studio: https://aistudio.google.com/apikey
# `python scripts/check_gemini.py` times the Flash models your key can use and tells you which to put here.
# If a model is busy or slow, PyroWatch tries the next one automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Seconds to wait for one model before trying the next (default 20)
# PYROWATCH_GEMINI_TIMEOUT=20

# Optional: spoken briefings
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional: Tiger Data (TimescaleDB) service URL, e.g. postgres://tsdbadmin:…@….tsdb.cloud.timescale.com:3xxxx/tsdb?sslmode=require
# Stores every prediction + fire detection as time series; plain PostgreSQL works too.
DATABASE_URL=

# Optional: shared secret PyroWatch Beacons send as X-Station-Token when posting sensor readings
STATION_TOKEN=

# Set to 1 on ONE machine only (the model owner's): saves each day's first live prediction to data/ledger/
PYROWATCH_RECORD_LEDGER=

# auto = live with per-source synthetic fallback · demo = fully offline · live = fail loudly
PYROWATCH_DATA_MODE=auto
